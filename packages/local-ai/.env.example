# Variáveis de ambiente para o módulo @agentflow/local-ai

# Nunca commitar este arquivo de exemplo com valores reais
# Renomeie para .env no seu ambiente local

NODE_ENV=development

# Configuração Ollama Local
OLLAMA_LOCAL_SERVER=http://127.0.0.1:11434

# Configuração Ollama Cloud/Remoto
OLLAMA_REMOTE_SERVER=https://meu-ollama.exemplo.com
OLLAMA_API_KEY=sua-chave-api-segura-aqui
